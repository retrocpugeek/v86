+/**
+ * Touch panel
+ * ===========
+ * A touch panel over the display: an FT6x36 controller on the badge's I2C
+ * bus (address ``0x38``). A real card10 hasn't one; the v86 emulator's card10
+ * has, with :c:macro:`TOUCH_WIDTH` x :c:macro:`TOUCH_HEIGHT` points over the
+ * display, from its top left corner as it is seen.
+ */
+
+/** Width of the touch panel, in its points. */
+#define TOUCH_WIDTH 640
+/** Height of the touch panel, in its points. */
+#define TOUCH_HEIGHT 320
+
+/** The finger on the touch panel. */
+struct touch_state {
+	/** Where it is (or was last), in the panel's points. */
+	uint16_t x, y;
+	/** Whether it is down. */
+	uint8_t down;
+};
+
+/**
+ * Read the touch panel.
+ *
+ * :param state: where the finger's state is written.
+ * :return: ``0`` on success or a negative value:
+ *
+ *    - ``-ENODEV``: There is no touch panel.
+ */
+API(API_TOUCH_READ, int epic_touch_read(struct touch_state *state));
+

diff --git a/epicardium/drivers/touch.c b/epicardium/drivers/touch.c
new file mode 100644
index 00000000..5bdf4d2e
--- /dev/null
+++ b/epicardium/drivers/touch.c
@@ -0,0 +1,39 @@
+/*
+ * A touch panel over the display (epic_touch_read, epicardium.h): an FT6x36
+ * controller on the badge's I2C bus. The v86 emulator's card10 has one; a
+ * real card10 hasn't, unless one is wired to the bus.
+ */
+#include "epicardium.h"
+#include "modules/modules.h"
+#include "drivers/drivers.h"
+
+#include "bosch.h"
+
+#include <errno.h>
+#include <stdint.h>
+
+#define FT6X36_ADDR 0x38
+
+static uint16_t last_x, last_y;
+
+int epic_touch_read(struct touch_state *state)
+{
+	/* TD_STATUS, P1_XH, P1_XL, P1_YH, P1_YL */
+	uint8_t r[5];
+	int8_t ret;
+
+	hwlock_acquire(HWLOCK_I2C);
+	ret = card10_bosch_i2c_read(FT6X36_ADDR, 0x02, r, sizeof(r));
+	hwlock_release(HWLOCK_I2C);
+	if (ret != 0) {
+		return -ENODEV;
+	}
+	state->down = (r[0] & 0x0f) != 0;
+	if (state->down) {
+		last_x = ((r[1] & 0x0f) << 8) | r[2];
+		last_y = ((r[3] & 0x0f) << 8) | r[4];
+	}
+	state->x = last_x;
+	state->y = last_y;
+	return 0;
+}

 /**
+ * Animation decoder
+ * =================
+ * Core 0 decodes an animation file's frames for core 1, in a task of its
+ * own, while core 1 shows the last one: :c:func:`epic_anim_decode` asks for
+ * the next frame and returns at once; when the frame is in core 1's buffer,
+ * core 0 raises :c:data:`EPIC_INT_ANIM_FRAME`.
+ *
+ * The file (``.rla``): ``"RLA1"``, then little-endian ``u16`` width, height,
+ * frame count and frames per second, 4 reserved bytes, a palette of 256
+ * RGB565 ``u16`` colours, then each frame: a ``u16`` length and that many
+ * bytes of PackBits (a byte ``n`` < 128: ``n + 1`` palette indexes follow;
+ * otherwise the next index, ``n - 126`` times). After the last frame, the
+ * first comes again.
+ */
+
+/** An open animation, as :c:func:`epic_anim_open` finds it */
+struct anim_info {
+	uint16_t width, height, frames, fps;
+};
+
+/**
+ * Open an animation for decoding (closing any other).
+ *
+ * :param path: The file.
+ * :param info: Its size, frame count and rate.
+ * :return: 0, or a negative error (``-EINVAL``: not an animation).
+ */
+API(API_ANIM_OPEN, int epic_anim_open(const char *path, struct anim_info *info));
+
+/**
+ * Decode the next frame into ``dest`` (``width * height`` RGB565 pixels),
+ * in the background on core 0: returns at once, and core 0 raises
+ * :c:data:`EPIC_INT_ANIM_FRAME` when the frame is there.
+ *
+ * :return: 0, ``-EBUSY`` if a frame is still being decoded, ``-EBADF`` if no
+ *    animation is open.
+ */
+API(API_ANIM_DECODE, int epic_anim_decode(uint16_t *dest));
+
+/** Close the animation (any frame being decoded is finished first). */
+API(API_ANIM_CLOSE, void epic_anim_close(void));
+
+/**
+ * **Interrupt Service Routine** for :c:data:`EPIC_INT_ANIM_FRAME`: a frame
+ * :c:func:`epic_anim_decode` asked for is ready.
+ */
+API_ISR(EPIC_INT_ANIM_FRAME, epic_isr_anim_frame);
+

# Kernel options added to Buildroot's qemu aarch64-virt config
# The display: a simple-framebuffer in RAM, described by the device tree
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
# Keyboard and tablet
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y
# The usual conveniences
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y

// Hosting for v86's aarch64 machine on Cloudflare Workers (free tier: static
// asset requests are free; 25 MiB per file, 20,000 files). The Worker script
// only handles /proxy (worker.js); everything else is a static asset.
// Build with tools/a64-site/build.sh and add-image.sh first.
{
  "name": "v86-arm",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "../../build/a64-site",
    "binding": "ASSETS",
    "run_worker_first": ["/proxy"]
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}

/* U-Boot environment for v86's aarch64 machine (qemu-arm's, minus USB,
 * the display and the boot devices it doesn't have) */

stdin=serial
stdout=serial
stderr=serial
fdt_addr=0x40000000
scriptaddr=0x40200000
pxefile_addr_r=0x40300000
kernel_addr_r=0x40400000
ramdisk_addr_r=0x44000000
boot_targets=virtio

# Changes to U-Boot's qemu_arm64_defconfig for v86's aarch64 machine (see
# build.sh): U-Boot is loaded into RAM (there's no flash), the DTB is at the
# start of RAM, and the only devices are PL011, PL031 and virtio-mmio.
CONFIG_POSITION_INDEPENDENT=y
CONFIG_ENV_SOURCE_FILE="v86"
# CONFIG_USE_PREBOOT is not set
CONFIG_BOOTDELAY=3
# No flash for the environment or anything else
# CONFIG_ENV_IS_IN_FLASH is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_MTD is not set
# CONFIG_DM_MTD is not set
# CONFIG_MTD_NOR_FLASH is not set
# CONFIG_CFI_FLASH is not set
# CONFIG_FLASH_CFI_MTD is not set
# CONFIG_SYS_FLASH_CFI is not set
# CONFIG_CMD_MTD is not set
# CONFIG_CMD_MTDPARTS is not set
# CONFIG_DFU_MTD is not set
# No PCI, USB, TPM or display
# CONFIG_PCI is not set
# CONFIG_CMD_PCI is not set
# CONFIG_USB is not set
# CONFIG_TPM is not set
# CONFIG_CMD_TPM is not set
# CONFIG_TPM2_MMIO is not set
# CONFIG_VIDEO is not set
# CONFIG_VIDEO_BOCHS is not set
# Boot with extlinux.conf only (no UEFI)
# CONFIG_EFI_LOADER is not set
# CONFIG_UNIT_TEST is not set
CONFIG_CMD_SQUASHFS=y
CONFIG_FS_SQUASHFS=y
# Host tool that needs GnuTLS
# CONFIG_TOOLS_MKEFICAPSULE is not set

# Buildroot configuration for the gdb-wui example on v86's aarch64 machine:
# gdb and gdb-wui (tools/gdb-wui-guest), on a read-only squashfs root.
# Built by build.sh, which substitutes @HERE@ and @OVERLAY@.
BR2_aarch64=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_TARGET_GENERIC_HOSTNAME="gdb-wui"
BR2_TARGET_GENERIC_ISSUE="Buildroot with gdb-wui on v86 (aarch64)"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="@OVERLAY@"
BR2_ROOTFS_POST_BUILD_SCRIPT="@HERE@/../../gdb-wui-guest/post-build.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/aarch64-virt/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@HERE@/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set
# gdb (the full debugger and gdbserver), and socat for S95gdb-wui's login links
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
BR2_PACKAGE_GDB_DEBUGGER=y
BR2_PACKAGE_SOCAT=y

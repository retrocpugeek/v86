10 REM THE MANDELBROT SET IN INTEGERS (64 IS 1.0)
20 FOR Y=-11 TO 11
30 FOR X=-33 TO 10
40 C=X*4: D=Y*7: A=0: B=0: I=0
50 T=A*A/64-B*B/64+C: B=2*A*B/64+D: A=T: I=I+1
60 IF A*A/64+B*B/64<256 AND I<16 THEN GOTO 50
70 IF I=16 THEN PRINT "#";: GOTO 100
80 IF I>4 THEN PRINT "+";: GOTO 100
90 IF I>2 THEN PRINT ".";: GOTO 100
95 PRINT " ";
100 NEXT X
110 PRINT
120 NEXT Y

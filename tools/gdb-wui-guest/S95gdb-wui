#!/bin/sh
# gdb-wui for the emulator page (the "gdb-wui" panel of tools/a64-site and
# tools/rv64-site; tools/gdb-wui-guest/overlay.sh installs it).
#
# Port 80: gdb-wui itself, with /root/demo as its project (or a
# microcontroller's firmware: gdb_wui.mcu below), the
# decompilations of its programs (if the image has them) and kuna. -listen-anywhere
# only because the page connects over v86's virtual network, which nothing
# but that page can reach.
# Port 81: a fresh single-use login link (gdb-wui -print-url) per connection,
# which the page reads before loading the UI.

export HOME=/root XDG_RUNTIME_DIR=/run/gdb-wui
# The programs' decompilations, written where the image was built
# (overlay.sh): the Decompiled tab, with no Ghidra here
SIDECARS=
[ -d /usr/share/gdb-wui/sidecars ] && SIDECARS="-decomp-sidecars /usr/share/gdb-wui/sidecars"
export SIDECARS
# And kuna, for any program, which the page this guest runs in serves on its
# port 5717 (tools/a64-site/guest-web.js, serve_kuna): the page is the
# guest's gateway. The Decompiled view offers both where there is a sidecar.
GATEWAY=$(ip route 2>/dev/null | awk '/^default/ { print $3; exit }')
KUNA="-kuna tcp:${GATEWAY:-192.168.86.1}:5717"
export KUNA
# gdb_wui.mcu=NAME on the kernel command line: debug a microcontroller's
# firmware instead, /root/mcu/NAME/NAME.elf with its sources, on the
# microcontroller the page runs next to this machine. The page offers its
# GDB stub on its port 3333 (tools/rv64-site/index.html, ?debug), as a
# debug probe would.
PROJECT=/root/demo
TARGET=
MCU=$(sed -n 's/.*gdb_wui\.mcu=\([A-Za-z0-9_.-]*\).*/\1/p' /proc/cmdline)
if [ -n "$MCU" ] && [ -f "/root/mcu/$MCU/$MCU.elf" ]; then
	PROJECT=/root/mcu/$MCU
	TARGET="target remote ${GATEWAY:-192.168.86.1}:3333"
fi
export PROJECT MCU TARGET

case "$1" in
start)
	printf "Starting gdb-wui: "
	mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
	start-stop-daemon -S -q -b -m -p /run/gdb-wui.pid -x /bin/sh -- -c \
		'exec /usr/bin/gdb-wui -addr 0.0.0.0:80 -listen-anywhere -open=false -no-config -project "$PROJECT" $SIDECARS $KUNA \
			${TARGET:+-exe "$MCU.elf" -gdb-command "$TARGET"} >/tmp/gdb-wui.log 2>&1'
	start-stop-daemon -S -q -b -m -p /run/gdb-wui-url.pid -x /usr/bin/socat -- \
		TCP-LISTEN:81,reuseaddr,fork SYSTEM:"/usr/bin/gdb-wui -print-url 2>/dev/null"
	echo "OK"
	;;
stop)
	printf "Stopping gdb-wui: "
	start-stop-daemon -K -q -p /run/gdb-wui-url.pid
	start-stop-daemon -K -q -p /run/gdb-wui.pid
	echo "OK"
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

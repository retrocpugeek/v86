#!/bin/sh
# gdb-wui for the emulator page (the "gdb-wui" panel of tools/a64-site and
# tools/rv64-site; tools/gdb-wui-guest/overlay.sh installs it).
#
# Port 80: gdb-wui itself, with /root/demo as its project (or a
# microcontroller's firmware: gdb_wui.mcu below), the
# decompilations of its programs (if the image has them) and kuna. -listen-anywhere
# only because the page connects over v86's virtual network, which nothing
# but that page can reach.
# Port 81: a fresh single-use login link (gdb-wui -print-url) per connection,
# which the page reads before loading the UI.
# Port 84, for firmware gdb's "rebuild" can rebuild (below): its sources
# and its last build, for the page to save (mcu-files).

export HOME=/root XDG_RUNTIME_DIR=/run/gdb-wui
# The programs' decompilations, written where the image was built
# (overlay.sh): the Decompiled tab, with no Ghidra here
SIDECARS=
[ -d /usr/share/gdb-wui/sidecars ] && SIDECARS="-decomp-sidecars /usr/share/gdb-wui/sidecars"
export SIDECARS
# gdb has 3 minutes, not gdb-wui's 30 seconds, to start: this machine is
# emulated, and on a slow computer, just after boot, gdb takes longer than
# that to answer its first command
START="-gdb-start-timeout 3m"
export START
# And kuna, for any program, which the page this guest runs in serves on its
# port 5717 (tools/a64-site/guest-web.js, serve_kuna): the page is the
# guest's gateway. The Decompiled view offers both where there is a sidecar.
GATEWAY=$(ip route 2>/dev/null | awk '/^default/ { print $3; exit }')
KUNA="-kuna tcp:${GATEWAY:-192.168.86.1}:5717"
export KUNA
# gdb_wui.mcu=NAME on the kernel command line: debug a microcontroller's
# firmware instead, /root/mcu/NAME/NAME.elf with its sources, on the
# microcontroller the page runs next to this machine. The page offers its
# GDB stub on its port 3333 (tools/rv64-site/index.html, ?debug), as a
# debug probe would. Without an ELF for NAME there (your own firmware on the
# page, ?build=upload), gdb_wui.exe=FILE names the page's firmware as an ELF
# (a .bin or .hex wrapped in one) that the page hands out on its port 5718
# (serve_file in guest-web.js), for gdb's symbols, if it has any, and for
# kuna to decompile. Without either, gdb connects all the same, without
# symbols: the stub tells it the architecture.
PROJECT=/root/demo
TARGET=
EXE=
MCU=$(sed -n 's/.*gdb_wui\.mcu=\([A-Za-z0-9_.-]*\).*/\1/p' /proc/cmdline)
if [ -n "$MCU" ]; then
	TARGET="target remote ${GATEWAY:-192.168.86.1}:3333"
	if [ -f "/root/mcu/$MCU/$MCU.elf" ]; then
		PROJECT=/root/mcu/$MCU
		EXE=$MCU.elf
	else
		PROJECT=/tmp/$MCU
		mkdir -p "$PROJECT"
		FILE=$(sed -n 's/.*gdb_wui\.exe=\([A-Za-z0-9_.-]*\).*/\1/p' /proc/cmdline)
		if [ -n "$FILE" ]; then
			# (a line asks for it; the page closes the connection after it)
			for i in 1 2 3; do
				echo get | socat -t 30 - "TCP:${GATEWAY:-192.168.86.1}:5718,connect-timeout=10" \
					> "$PROJECT/$FILE" 2>/dev/null && [ -s "$PROJECT/$FILE" ] && EXE=$FILE && break
				sleep 2
			done
		fi
	fi
fi
# Firmware with a build script here (/root/mcu/NAME/build, which compiles
# its sources with this machine's GCC): gdb's "rebuild" command runs it,
# then loads the new ELF's symbols, writes it into the microcontroller's
# flash through the stub (load) and resets it, halted at its reset vector
# (the stub's reset keeps the flash as it is). gdb-shell relays the build's
# output to gdb's console.
REBUILD=
if [ -n "$TARGET" ] && [ -n "$EXE" ] && [ -x "$PROJECT/build" ]; then
	# (the root file system is read-only: a copy in memory, at the same
	# path, which the debug info names, to edit and build in)
	if [ "$1" = start ] && ! grep -q " $PROJECT " /proc/mounts; then
		mkdir -p /run/mcu
		cp -a "$PROJECT" /run/mcu/ && mount --bind "/run/mcu/$MCU" "$PROJECT"
	fi
	REBUILD=$XDG_RUNTIME_DIR/rebuild.gdb
	mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
	cat > "$REBUILD" <<-EOF
	define rebuild
	  shell /usr/libexec/gdb-wui/gdb-shell $XDG_RUNTIME_DIR/build.gdb $PROJECT/build
	  source $XDG_RUNTIME_DIR/build.gdb
	  if \$_shell_exitcode == 0
	    set confirm off
	    file $PROJECT/$EXE
	    load
	    monitor reset halt
	    flushregs
	    set confirm on
	    echo Rebuilt, flashed and reset: continue to run it.\\n
	  else
	    echo The build failed: the microcontroller still has the old firmware.\\n
	  end
	end
	document rebuild
	Rebuilds $EXE from the sources in $PROJECT ($PROJECT/build),
	writes it into the microcontroller's flash and resets it, halted.
	end
	EOF
fi
export PROJECT MCU TARGET EXE REBUILD
# gdb_wui.card10 on the kernel command line: the card10 badge's two cores,
# each with its own debugger (tools/a64-site/index.html, ?build=card10&debug):
# a gdb-wui for core 0 (Epicardium) on port 80 and one for core 1
# (Pycardium) on port 82, their login links on 81 and 83, each connecting to
# its core's GDB stub on the page's port 3333 or 3334 (with a remote timeout
# for the round trips through two emulated machines). /root/mcu/card10 has
# the ELFs and their sources, built under /firmware.
CARD10=
grep -q 'gdb_wui\.card10' /proc/cmdline && [ -f /root/mcu/card10/epicardium.elf ] && CARD10=/root/mcu/card10
export CARD10

# card10_wui PORT ELF STUB_PORT: one core's gdb-wui
card10_wui() {
	start-stop-daemon -S -q -b -m -p "/run/gdb-wui-$1.pid" -x /bin/sh -- -c \
		"exec /usr/bin/gdb-wui -addr 0.0.0.0:$1 -listen-anywhere -open=false -no-config $START -project $CARD10 \$KUNA \
			-exe $2 -gdb-command 'set substitute-path /firmware $CARD10/firmware' \
			-gdb-command 'set remotetimeout 30' \
			-gdb-command 'target remote ${GATEWAY:-192.168.86.1}:$3' >/tmp/gdb-wui-$1.log 2>&1"
	# (the address through the environment: socat would take a ':' in its
	# SYSTEM command for its own)
	start-stop-daemon -S -q -b -m -p "/run/gdb-wui-url-$1.pid" -x /usr/bin/env -- WUI_ADDR=":$1" /usr/bin/socat \
		TCP-LISTEN:$(($1 + 1)),reuseaddr,fork SYSTEM:'/usr/bin/gdb-wui -print-url -addr $WUI_ADDR 2>/dev/null'
}

case "$1" in
start)
	printf "Starting gdb-wui: "
	mkdir -p -m 0700 "$XDG_RUNTIME_DIR"
	if [ -n "$CARD10" ]; then
		card10_wui 80 epicardium.elf 3333
		card10_wui 82 pycardium.elf 3334
		echo "OK (the card10's two cores)"
		exit 0
	fi
	start-stop-daemon -S -q -b -m -p /run/gdb-wui.pid -x /bin/sh -- -c \
		'exec /usr/bin/gdb-wui -addr 0.0.0.0:80 -listen-anywhere -open=false -no-config $START -project "$PROJECT" $SIDECARS $KUNA \
			${EXE:+-exe "$EXE"} ${TARGET:+-gdb-command "$TARGET"} ${REBUILD:+-gdb-command "source $REBUILD"} >/tmp/gdb-wui.log 2>&1'
	start-stop-daemon -S -q -b -m -p /run/gdb-wui-url.pid -x /usr/bin/socat -- \
		TCP-LISTEN:81,reuseaddr,fork SYSTEM:"/usr/bin/gdb-wui -print-url 2>/dev/null"
	# (port 84: see above)
	if [ -n "$REBUILD" ]; then
		start-stop-daemon -S -q -b -m -p /run/mcu-files.pid -x /usr/bin/socat -- \
			TCP-LISTEN:84,reuseaddr,fork EXEC:"/usr/libexec/gdb-wui/mcu-files $PROJECT $EXE"
	fi
	echo "OK"
	;;
stop)
	printf "Stopping gdb-wui: "
	for p in /run/mcu-files.pid /run/gdb-wui-url.pid /run/gdb-wui.pid /run/gdb-wui-url-80.pid /run/gdb-wui-80.pid \
		/run/gdb-wui-url-82.pid /run/gdb-wui-82.pid; do
		[ -f "$p" ] && start-stop-daemon -K -q -p "$p"
	done
	echo "OK"
	;;
restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

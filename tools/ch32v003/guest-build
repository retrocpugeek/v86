#!/bin/sh
# Rebuilds tetris.elf from the sources next to it, in the v86-riscv site's
# gdb-wui image (/root/mcu/tetris/build; tools/rv64-gdb/build.sh puts it
# there), with the image's own GCC: as tools/ch32v003/build.sh builds it.
# gdb's "rebuild" runs it, then flashes the result into the CH32V003.
# Elsewhere (the sources saved from the page), with a RISC-V GCC that does
# rv32ec: CROSS=riscv64-unknown-elf- ./build
set -e
cd "$(dirname "$0")"
"${CROSS:-}gcc" -march=rv32ec_zicsr -mabi=ilp32e -Os -g -ffreestanding -nostdlib -fno-builtin -fno-stack-protector -fno-pie -no-pie -static \
  -ffunction-sections -fdata-sections -Wall -Wextra \
  -T link.ld -Wl,--gc-sections -o tetris.elf start.S tetris.c libgcc.c
"${CROSS:-}size" tetris.elf
